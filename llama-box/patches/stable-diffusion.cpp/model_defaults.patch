+void sd_get_model_defaults(const sd_ctx_t* sd_ctx, sd_model_defaults_t* defaults) {
+    if (defaults == nullptr) {
+        return;
+    }
+
+    *defaults = {};
+    defaults->strength        = 0.75f;
+    defaults->sampling_steps = 20;
+    defaults->cfg_scale      = 4.5f;
+    defaults->width          = 1024;
+    defaults->height         = 1024;
+
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr) {
+        return;
+    }
+
+    const SDVersion version = sd_ctx->sd->version;
+    if (sd_version_is_qwen_image(version)) {
+        defaults->sampling_steps = 40;
+        defaults->cfg_scale      = 2.5f;
+        return;
+    }
+
+    switch (version) {
+        case VERSION_SD1_INPAINT:
+        case VERSION_SD2_INPAINT:
+        case VERSION_SDXL_INPAINT:
+        case VERSION_FLUX_FILL:
+            defaults->strength = 1.0f;
+            defaults->sampling_steps = 50;
+            break;
+        default:
+            break;
+    }
+
+    switch (version) {
+        case VERSION_SD1:
+        case VERSION_SD1_INPAINT:
+        case VERSION_SD2:
+        case VERSION_SD2_INPAINT:
+            defaults->cfg_scale = 9.0f;
+            defaults->width = 512;
+            defaults->height = 512;
+            break;
+        case VERSION_SDXL_INPAINT:
+            defaults->cfg_scale = 5.0f;
+            defaults->width = 512;
+            defaults->height = 512;
+            break;
+        case VERSION_SDXL:
+        case VERSION_SDXL_PIX2PIX:
+        case VERSION_SDXL_SSD1B:
+            defaults->cfg_scale = 5.0f;
+            defaults->sampling_steps = 25;
+            break;
+        case VERSION_SD3:
+            defaults->cfg_scale = 4.5f;
+            break;
+        case VERSION_FLUX:
+            defaults->cfg_scale = 1.0f;
+            break;
+        case VERSION_FLUX_FILL:
+            defaults->cfg_scale = 3.5f;
+            break;
+        default:
+            break;
+    }
+}
