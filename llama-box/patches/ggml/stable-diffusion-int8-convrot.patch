+template <int N>
+__global__ void regular_hadamard_cuda(const float * src, float * dst, const int64_t n_groups, const float scale) {
+    const int64_t group = blockIdx.x;
+    const int tid       = threadIdx.x;
+    if (group >= n_groups) {
+        return;
+    }
